": {"app_label": "Subnautica", "model": "floras"}}, {"model": "sessions.session", "pk": "84lafzkh0n5qhe9x7zwo68ukaru11pgo", "fields": {"session_data": "eyJ1c2VybmFtZSI6InJvb3QiLCJyb2xlIjoiYWRtaW4ifQ:1u2YIp:r2HoyJc091Kt7fYADyIiHJvMVd-Fd5Et9O7fB1vi2cM", "expire_date": "2025-04-23T16:29:27.432Z"}}, {"model": "sessions.session", "pk": "atodl43jugg26phmphuz5je3xqibqcy4", "fields": {"session_data": "eyJ1c2VybmFtZSI6InJvb3QiLCJyb2xlIjoiYWRtaW4ifQ:1u2qxk:GTAxWXZf3fg3Ciw6iLTPfD7DyExiU0c5wIOGyAgWJT0", "expire_date": "2025-04-24T12:24:56.381Z"}}, {"model": "sessions.session", "pk": "hz6swdsgw3ereg5owpymeux28qemwwks", "fields": {"session_data": "eyJ1c2VybmFtZSI6InJvb3QiLCJyb2xlIjoiYWRtaW4ifQ:1u27rR:lh4JhQOTIq8GeFruid0M4j2gwZf7qCNbxnTjZxL_zFU", "expire_date": "2025-04-22T12:15:25.268Z"}}, {"model": "sessions.session", "pk": "vx3nbd00o0aij9i9bhvymag776zbxk18", "fields": {"session_data": "eyJ1c2VybmFtZSI6InJvb3QiLCJyb2xlIjoiYWRtaW4ifQ:1u1mfk:U_NElDIiGt5vEwP7bawsmNWaMJnEWufdzYcBOZpU0JE", "expire_date": "2025-04-21T13:37:56.239Z"}}, {"model": "Subnautica.biomes", "pk": 19, "fields": {"name": "Blood Kelp Caves", "description": "This biome is known for its eerie atmosphere and its abundance of large Bloodroots that grow on every surface and carry large pustules of Blood Oil. These caves also offer extensive bioluminescent flora and rock formations.", "short_description": "These caves are characterized by Bloodroots that grow large pustules of Blood Oil", "biome_type": "Cave", "depth_range": "285 - 675 meters", "temp_range": "N/A", "resources": [2]}}, {"model": "Subnautica.biomes", "pk": 20, "fields": {"name": "Safe Shallows", "description": "The Safe Shallows is the starter biome for new players and contains sprawling coral reefs and small cave systems. As the name implies, this shallow biome is one of the safest in the game, with no predatory creatures. However, there are environmental hazards and it is quite easy to be disoriented by the winding caves and run out of oxygen. Some predators can wander into this biome from the Kelp Forest and Grassy Plateaus. This biome offers plentiful diving experiences for new players, with a variety of flora, fauna, and resources. At night time, this biome truly shows its alien nature with plentiful bioluminescence.", "short_description": "The beginning biome know for its lack of hostile creatures. This biome is full of fauna and flora for the player to interact with.", "biome_type": "Surface", "depth_range": "0 - 80 meters", "temp_range": "26.5℃ - 32℃", "resources": [3]}}, {"model": "Subnautica.biomes", "pk": 21, "fields": {"name": "Sparse Reef", "description": "The Sparse Reef is a vast sprawling region that consists of mostly flat areas with scattered clusters of spire rock structures. This biome contains the entrance to a deeper cave system called Deep Sparse Reef.", "short_description": "A sparse and gloomy biome that covers a sprawling region.", "biome_type": "Surface", "depth_range": "40 - 310 meters", "temp_range": "13.7℃ - 29.8℃", "resources": [4]}}, {"model": "Subnautica.tools", "pk": 3, "fields": {"name": "Survival Knife", "description": "The Survival Knife is a basic survival tool that can be used for self-defense.", "short_description": "Standard issue basic survival tool", "tool_type": "Defense", "build_time": "3 seconds", "attribute": "Defense"}}, {"model": "Subnautica.vehicles", "pk": 1, "fields": {"name": "Cyclops", "description": "The Cyclops is a vast multi-person submarine capable of functioning as a mobile base.     It also features an onboard artificial intelligence, multiple upgrade systems, sonar, fire suppression systems, and camera systems.", "short_description": "A vast industrial-grade multiple person submarine", "velocity": "<ul>         <li><a>Ahead Slow: 5.4</a></li>         <li><a>Ahead Standard: 8.2</a></li>         <li><a>Flank: 10.5</a></li>         <li><a>Reverse: 4.8</a></li>         <li><a>Vertical: 3.1</a></li>     </ul>", "health": 1500, "acq_from": "Fragments"}}, {"model": "Subnautica.faunas", "pk": 6, "fields": {"name": "Ampeel", "description": "Ampeels are an aggressive species that can be found in the Bulb Zone and the Blood Kelp Zone. They frequently emit shocking electricity to their surrounding area and deal significant damage to vehicles left unattended.", "fauna_type": "Predator", "attitude": "Aggressive", "biomes": [19]}}, {"model": "Subnautica.faunas", "pk": 7, "fields": {"name": "Crashfish", "description": "The Crashfish is a species that dwells within Sulfur Plants found within the Safe Shallows and its caves. They have a defense mechanism that sees them rush any intruder before exploding.", "fauna_type": "Herbivore", "attitude": "Defensive", "biomes": [20]}}, {"model": "Subnautica.faunas", "pk": 8, "fields": {"name": "Reaper Leviathan", "description": "The Reaper Leviathan is an extremely aggressive leviathan class predator found throughout the Crater's Edge. Encounters with these leviathans leave few survivors and avoidance is highly recommended. They hunt through sound, so if you can hear one, then it can see you.", "fauna_type": "Leviathan", "attitude": "Aggressive", "biomes": [21]}}, {"model": "Subnautica.floras", "pk": 6, "fields": {"name": "Acid Mushroom", "description": "Acid Mushrooms are a hazardous species of flora that can be used to manufacture Batteries when combined with Copper Ore. This flora releases dangerous acids into the water when disturbed that can be hazardous to the player. The Acid Mushroom can be regrown in growbeds and Alien Containment.", "use": "Crafting Batteries", "attitude": "Hazardous", "obtain_from": "Seabed", "growth_time": 0, "biomes": [20]}}, {"model": "Subnautica.floras", "pk": 7, "fields": {"name": "Bloodroot", "description": "Bloodroot is a flora species that are prominent in the Blood Kelp Caves.They appear as large root-like plants that protrude from the seabed. They are known for growing Blood Oil", "use": "Holds Blood Oil", "attitude": "Harvestable", "obtain_from": "N/A", "growth_time": 0, "biomes": [19]}}, {"model": "Subnautica.eggs", "pk": 16, "fields": {"name": "Ampeel", "description": "Ampeel Egg", "attitude": "Aggressive", "fauna": 6, "biomes": [19]}}, {"model": "Subnautica.resources", "pk": 2, "fields": {"name": "Blood Oil", "description": "Blood Oil is a rare seed that can be used in advanced crafting recipes. They are exclusively found growing on Bloodroots within the Blood Kelp Zone and Blood Kelp Caves.", "obtain_from": "Seabed", "size": 4, "biomes": [19]}}, {"model": "Subnautica.resources", "pk": 3, "fields": {"name": "Cave Sulfur", "description": "Cave Sulfur is a sulfur-based material, which can be found in Sulfur Plant. It can be found in Crashfish's nests after they leave it.", "obtain_from": "Sulfur Plant", "size": 1, "biomes": [20]}}, {"model": "Subnautica.resources", "pk": 4, "fields": {"name": "Titanium", "description": "Titanium is a material that is heavily used in many crafting recipes.                 It is one of the earliest resources the player can obtain and is very common.", "obtain_from": "Seabed", "size": 1, "biomes": [21]}}]